{
  "mcpServers": {
    "higgsfield": {
      "type": "http",
      "url": "https://mcp.higgsfield.ai/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chrome",
        "--headless",
        "--isolated",
        "--viewport-size",
        "1440x900",
        "--output-dir",
        "films-src/qa"
      ]
    }
  }
}
